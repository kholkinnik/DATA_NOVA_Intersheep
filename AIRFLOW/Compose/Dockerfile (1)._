FROM apache/airflow:2.9.2

USER root

# Системные пакеты + Java
RUN apt-get update && \
    apt-get install -y --no-install-recommends default-jdk wget ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Spark
RUN wget -q https://archive.apache.org/dist/spark/spark-3.4.2/spark-3.4.2-bin-hadoop3.tgz && \
    mkdir -p /opt/spark && \
    tar -xzf spark-3.4.2-bin-hadoop3.tgz -C /opt/spark && \
    rm -f spark-3.4.2-bin-hadoop3.tgz

ENV SPARK_HOME=/opt/spark/spark-3.4.2-bin-hadoop3
ENV PATH=$PATH:$SPARK_HOME/bin

# JAVA_HOME (корректно для amd64/arm64)
RUN ARCH="$(dpkg --print-architecture)" && \
    echo "Detected arch=${ARCH}" && \
    echo "JAVA_HOME=/usr/lib/jvm/java-17-openjdk-${ARCH}" >> /etc/environment && \
    ln -sf "/usr/lib/jvm/java-17-openjdk-${ARCH}" /opt/java_home
ENV JAVA_HOME=/opt/java_home
ENV PATH=$PATH:$JAVA_HOME/bin

# JDBC jar-ы для Spark (Postgres + MySQL)
RUN mkdir -p /opt/jars && \
    wget -q -O /opt/jars/postgresql.jar https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.3/postgresql-42.7.3.jar && \
    wget -q -O /opt/jars/mysql.jar https://repo1.maven.org/maven2/com/mysql/mysql-connector-j/8.4.0/mysql-connector-j-8.4.0.jar

# Python requirements
COPY requirements.txt /requirements.txt
RUN chmod 777 /requirements.txt

# ===== JDBC драйверы для Spark =====
RUN mkdir -p /opt/jars && \
    wget -O /opt/jars/postgresql.jar https://jdbc.postgresql.org/download/postgresql-42.7.3.jar && \
    wget -O /opt/jars/mysql.jar https://repo1.maven.org/maven2/com/mysql/mysql-connector-j/8.4.0/mysql-connector-j-8.4.0.jar

USER airflow
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r /requirements.txt